# EcoFinance: copiar para .env; nunca publicar segredos reais.
FIREBASE_PROJECT_ID="ecofinance-912de"
FIRESTORE_DATABASE_ID="ecofinance"
# Produção: ADC/workload identity no servidor; nunca enviar chave ao navegador.
# Local: FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# GOOGLE_APPLICATION_CREDENTIALS: caminho local para ADC, se necessário.
# URL canônica HTTPS em produção. HTTP somente localhost/emulador.
AUTH_URL="http://localhost:3000"
# Gerar uma chave aleatória de pelo menos 32 caracteres, exclusiva do servidor.
# Exemplo de geração: openssl rand -hex 32
AUTH_SECRET=""
# Apenas endereço público do servidor, sem credencial.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"
# Não há segredo global compartilhado com o app.
# Integrações legadas estão desativadas até seus substitutos revisados.
# TEST_DATABASE_URL: somente PostgreSQL local descartável para ensaio legado;
# seguir docs/refatoracao/autenticacao.md para os testes.
