<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Optional expense capture (#19). Only the system can bind a service protected by
      BIND_NOTIFICATION_LISTENER_SERVICE, and it does so only after the user grants
      notification access in the system settings. No uses-permission is added.
    -->
    <service
      android:name="com.ecofinance.capture.CaptureListenerService"
      android:label="EcoFinance: captura de gastos"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
