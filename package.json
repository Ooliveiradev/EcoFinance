{
  "name": "ecofinance",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:source": "node scripts/security/check-source.mjs",
    "security:bundle": "node scripts/security/check-bundle.mjs",
    "security:selftest": "node --test scripts/security/*.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "mobile:check": "turbo check --filter=@ecofinance/expo",
    "db:migrate": "pnpm --filter @ecofinance/db db:migrate",
    "db:snapshot": "tsx packages/db/scripts/portable-snapshot.ts",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "clean": "turbo clean",
    "security:audit": "node scripts/security/audit.mjs",
    "db:verify-recovery": "tsx packages/db/scripts/verify-recovery.ts",
    "auth:user": "pnpm --filter @ecofinance/next auth:user"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.20.0",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "nanoid@<4": "3.3.18",
      "postcss@<8.5.18": "8.5.23",
      "browserslist@<4.28.7": "4.28.7",
      "@xmldom/xmldom@>=0.9 <0.9.12": "0.9.12",
      "sharp@<0.35.4": "0.35.5",
      "decode-uri-component@<0.5.0": "0.5.0",
      "uuid@<11": "11.1.1",
      "esbuild@<0.25": "0.25.12"
    },
    "patchedDependencies": {
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  }
}
