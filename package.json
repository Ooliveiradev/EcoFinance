{
  "name": "ecofinance",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo typecheck && tsc --project tsconfig.tools.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:source": "node scripts/security/check-source.mjs",
    "security:bundle": "node scripts/security/check-bundle.mjs",
    "security:selftest": "node --test scripts/security/*.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "mobile:check": "turbo check --filter=@ecofinance/expo",
    "db:migrate": "pnpm --filter @ecofinance/db db:migrate",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.19",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
