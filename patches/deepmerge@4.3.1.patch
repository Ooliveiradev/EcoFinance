--- a/dist/cjs.js
+++ b/dist/cjs.js
@@ -80,6 +80,10 @@ function mergeObject(target, source, options) {
 	var destination = {};
 	if (options.isMergeableObject(target)) {
 		getKeys(target).forEach(function(key) {
+			// GHSA-gcqx-w48m-w2h4: an own "__proto__" key would replace the prototype of the result.
+			if (key === "__proto__") {
+				return
+			}
 			destination[key] = cloneUnlessOtherwiseSpecified(target[key], options);
 		});
 	}
